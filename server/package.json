{
  "name": "@broadcast-server/server",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket broadcast server with per-room routing, JWT sessions, and MongoDB message history",
  "main": "src/index.js",
  "bin": {
    "broadcast-server": "./src/cli.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.js",
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "cli": "node --env-file-if-exists=../.env src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "ws": "^8.21.3"
  }
}
