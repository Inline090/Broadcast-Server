{
  "name": "broadcast-server",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time message broadcasting platform with a React client and Node.js WebSocket server",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/src/index.js",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "cli": "node --env-file-if-exists=.env server/src/cli.js",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm test --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  }
}
